# Supabase Project Settings > API / Connect で確認する公開情報です。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 旧形式のプロジェクトでは、上のPUBLISHABLE_KEYの代わりに次を利用できます。
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 管理処理専用。アカウント削除とcleanupで利用します。通常の共有表示・クイズには不要です。
# NEXT_PUBLIC_ を付けず、ブラウザへ公開しないでください。実際の値はコミットしません。
SUPABASE_SECRET_KEY=
# 日次クリーンアップの呼び出し認証用。
CRON_SECRET=

# 任意。設定すると全画面共通でループ再生され、設定画面のBGM音量が反映されます。
NEXT_PUBLIC_BGM_URL=

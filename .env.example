# Supabase Project Settings > API / Connect で確認する公開情報だけを設定します。
# service_role / secret key はフロントエンドへ設定しないでください。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 旧形式のプロジェクトでは、上のPUBLISHABLE_KEYの代わりに次を利用できます。
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 任意。設定すると全画面共通でループ再生され、設定画面のBGM音量が反映されます。
NEXT_PUBLIC_BGM_URL=
